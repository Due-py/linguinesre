# Copy this file to .env.local (never commit .env.local) and fill in the values
# from Supabase → Project Settings → API Keys. Put the same 3 values in
# Vercel → Project → Settings → Environment Variables, then redeploy.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...). Safe to be seen by the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). SERVER ONLY. Never share it, never paste it in chat.
SUPABASE_SECRET_KEY=
