# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG đưa .env.local lên GitHub hay dán vào chat.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở máy chủ. TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# Địa chỉ gốc của web (dùng cho liên kết trong email xác nhận / đặt lại mật khẩu).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chép lời (giai đoạn 2)
DEEPGRAM_API_KEY=

# Phản hồi và giọng đọc câu hỏi (giai đoạn 2). Tên mô hình do bạn chọn, không viết cứng trong mã.
OPENAI_API_KEY=
OPENAI_FEEDBACK_MODEL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15

# Chấm phát âm từng từ, âm tiết, âm (Azure AI Speech, Pronunciation Assessment). Chỉ ở máy chủ.
# Azure portal > tạo "Speech service" (gói F0 miễn phí) > Keys and Endpoint: lấy KEY 1 và Location/Region (VD: southeastasia).
# Để trống thì web ghi rõ "chưa bật chấm phát âm chi tiết", các phần khác vẫn chạy.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Hoặc (miễn phí trong hạn mức Modal): máy chấm mã nguồn mở tự chạy (wav2vec2 + espeak-ng, chấm từng âm, âm tiết, từ).
# PRON_SERVER_URL dạng https://<workspace>--lingua-pron-web.modal.run (services/pron-modal); PRON_SECRET giống hệt secret "lingua-pron" trên Modal.
PRON_SERVER_URL=
PRON_SECRET=

# 1 = dùng bản giả cho Deepgram/OpenAI (test tự động, xem giao diện không tốn tiền). Không bật ở production.
MOCK_AI=0

# Trang thống kê nghiên cứu (/research): cổng Google Sheets do Apps Script tạo (research-system/HUONG-DAN.md, bước 4).
# Chỉ ở máy chủ. Không có thì trang vẫn chạy, phần Google Forms hiện "Chưa kết nối".
RESEARCH_SHEETS_URL=
RESEARCH_SHEETS_SECRET=
